# Copy to .env.local and fill in. .env.local is gitignored.

# Supabase personal access token (supabase.com/dashboard/account/tokens).
# Grants full access to your Supabase account: treat it like a password.
SUPABASE_ACCESS_TOKEN=

# Project ref from your dashboard URL: supabase.com/dashboard/project/<ref>
SUPABASE_PROJECT_REF=

# Browser-safe Supabase credentials for the web app.
# Never put the service_role key here: it bypasses row-level security.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: local projection exports, used by the integration test.
KEEPER_SKILL_PROJECTIONS_CSV=
KEEPER_DEFENSE_PROJECTIONS_CSV=
